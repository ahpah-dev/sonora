{
  "name": "sonora-desktop",
  "productName": "Sonora",
  "version": "5.2.1",
  "private": true,
  "description": "Sonora music studio with a local Codex music assistant",
  "author": "Sonora contributors",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "electron smoke.cjs --smoke-test && electron listening-smoke.cjs --smoke-test && electron timeline-smoke.cjs --smoke-test && electron apply-smoke.cjs --smoke-test && electron composition-smoke.cjs --smoke-test && electron studio-smoke.cjs --smoke-test && electron clip-smoke.cjs --smoke-test",
    "prepare-assets": "node prepare.cjs",
    "package": "npm run prepare-assets && electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "@openai/codex": "0.161.0",
    "@resvg/resvg-js": "2.6.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.sonoradaw.desktop",
    "asar": true,
    "directories": {
      "output": "../desktop-release"
    },
    "files": [
      "main.cjs",
      "engine.cjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "studio",
        "filter": [
          "**/*",
          "!downloads/**"
        ]
      },
      {
        "from": "../shared",
        "to": "shared"
      },
      {
        "from": "node_modules/@openai/codex-win32-x64/vendor",
        "to": "codex"
      },
      {
        "from": "icon.png",
        "to": "icon.png"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "licenses",
        "to": "licenses"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Sonora-${version}-win-x64.exe",
      "useZip": true
    }
  }
}
